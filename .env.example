# Variable names only: this file contains no values or credentials.
# The application and env validator will be created during PHASE 0.
# Set local values in an ignored .env.local; never commit real secrets.
APP_ENV=
APP_URL=
LOG_LEVEL=
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Add auth, worker, storage and AI variables with their corresponding modules.
# Runtime DATABASE_URL must not use migration/admin credentials.

# Public site Worker; local values belong to ignored .dev.vars.
SITE_URL=
BETTER_AUTH_SECRET=

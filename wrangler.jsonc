{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accountant-public-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "out", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "accountant-site-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }]
}
